<odoo>
    <data noupdate="1">

        <!-- Scheduled Action to trigger the Canalocio product import recordset -->
        <record id="ir_cron_sync_canalocio_products" model="ir.cron">
            <field name="name">Canalocio Importer: Run Product Sync</field>
            <field name="model_id" ref="connector_importer.model_import_recordset" />
            <field name="state">code</field>
            <field
                name="code"
            >model.browse(ref('connector_importer_canal.import_recordset_product_product_canal')).run_batch()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
            <field name="active" eval="False" />
            <field
                name="nextcall"
                eval="(DateTime.now().replace(hour=3, minute=30, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
            />
            <field name="cron_name">Canalocio Sync Cron</field>
        </record>

    </data>
</odoo>
